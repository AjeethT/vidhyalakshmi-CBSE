# Vidhyalakshmi School Website - Environment Configuration

# ============================================
# CLOUDFLARE R2 CONFIGURATION
# ============================================
# R2 is exposed through the Cloudflare custom domain.
# Public files live under the CBSE folder, then keep the normal project paths.
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.vidhyalakshmi.cus.firrham.com
NEXT_PUBLIC_R2_ROOT_FOLDER=CBSE

# R2 API Credentials (Server-side only - NEVER expose to frontend)
# These should ONLY be used in server-side API routes
# Get from: https://dash.cloudflare.com/
R2_ACCOUNT_ID=05a0ae511f5f3b99e20db1fd677443b4
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=vidhyalakshmi-content

# ============================================
# CLOUDFLARE API TOKEN
# ============================================
# Used for server-side operations only
# IMPORTANT: Never expose this token to frontend code
CLOUDFLARE_API_TOKEN=cfat_NKbEi9dweDoIUTftmqqLr7ULNCW3xIW8u9JxXBBxd1f485ce

# ============================================
# SCHOOL INFORMATION
# ============================================
NEXT_PUBLIC_SCHOOL_NAME=Vidhyalakshmi Senior Secondary School
NEXT_PUBLIC_SCHOOL_EMAIL=info@vidhyalakshmi.edu.in
NEXT_PUBLIC_SCHOOL_PHONE=96265 96111, 95855 36111, 9443320156
NEXT_PUBLIC_SCHOOL_ADDRESS=Katpadi-Gudiyattam Road, Keelpudur Village, Chennangkuppam Post, K V Kuppam Taluk, Vellore District

# ============================================
# SEO & ANALYTICS
# ============================================
# Google Analytics ID (optional)
NEXT_PUBLIC_GA_ID=

# Site base URL
NEXT_PUBLIC_SITE_URL=https://www.vidhyalakshmi.edu.in

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Enable debug logging (development only)
DEBUG=false

# Node environment
NODE_ENV=production
